{
  "name": "@bossnyumba/marketing",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('node:fs').accessSync('.env.local', require('node:fs').constants.R_OK); console.log('[predev] .env.local OK')\"",
    "dev": "bash -c 'set -a && [ -f .env.local ] && source .env.local; set +a; WATCHPACK_POLLING=true next dev --port 3010'",
    "dev:turbo": "bash -c 'set -a && [ -f .env.local ] && source .env.local; set +a; WATCHPACK_POLLING=true next dev --turbo --port 3010'",
    "dev:clean": "rm -rf .next && pnpm dev",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@bossnyumba/api-sdk": "workspace:*",
    "@bossnyumba/chat-ui": "workspace:*",
    "@bossnyumba/design-system": "workspace:*",
    "@bossnyumba/genui": "workspace:*",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-vitals": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3"
  }
}
