# --- API key registry -------------------------------------------------------
# [DEPLOY] Comma-separated entries:
#   "sha256hex:tenantId:role:space-delimited-scopes:serviceName"
# Generate: echo -n "$KEY" | openssl dgst -sha256 -hex | awk '{print $2}'
# REQUIRED in production for any agent-to-agent / service API-key auth.
API_KEY_REGISTRY=
# !! FORBIDDEN in production — the gateway THROWS at boot if API_KEYS is set with
# NODE_ENV=production (plaintext compare + blanket SUPER_ADMIN). Dev-only shim;
# migrate every entry to API_KEY_REGISTRY above.
API_KEYS=                                     # [LEGACY] dev-only; forbidden in prod

# --- Webhook infrastructure -------------------------------------------------
WEBHOOK_DEFAULT_HMAC_SECRET=
WEBHOOK_SSRF_ALLOW_PRIVATE=                   # 'true' allows private-IP webhook destinations (DEV ONLY)
WEBHOOK_REQUIRE_TIMESTAMP=                    # 'true' enforces signed-timestamp replay protection
# Internal-call shared secret for document-intelligence service routes.
# With DOCUMENT_INTELLIGENCE_INTERNAL_REQUIRED=true the service rejects calls
# lacking the matching header — set both in production.
DOCUMENT_INTELLIGENCE_INTERNAL_SECRET=
DOCUMENT_INTELLIGENCE_INTERNAL_REQUIRED=      # 'true' enforces the internal secret

# --- Outbox + cron supervisors ----------------------------------------------
# See Docs/RUNBOOKS/cron-supervisor-debug.md.
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_WORKER_DISABLED=
# [DEPLOY] Durable transactional-outbox backing store for the standalone
# outbox-processor service. MUST be 'redis' or 'postgres' — the service
# REFUSES to start when unset. Required wherever outbox-processor runs.
OUTBOX_STORE_TYPE=postgres                    # redis|postgres
OUTBOX_PROCESSOR_INTERVAL_MS=                 # outbox-processor poll cadence
OUTBOX_PROCESSOR_BATCH_SIZE=                  # outbox-processor batch size
CASES_SLA_INTERVAL_MS=60000
BOSSNYUMBA_CASES_SLA_DISABLED=                # 'true' disables the case-SLA supervisor
WAKE_LOOP_INTERVAL_MS=                        # wake-loop cron cadence
SOVEREIGN_LEDGER_VERIFY_INTERVAL_MS=          # audit-chain verifier cadence
SOVEREIGN_LEDGER_FAIL_CLOSED=true             # [DEPLOY] fail-CLOSED on sovereign audit-write failure (DEFAULT). An irreversible sovereign action (eviction/payout/KRA) MUST NOT report success if its hash-chained audit row fails to write. Set SOVEREIGN_LEDGER_FAIL_OPEN=1 ONLY for legacy back-compat — NEVER in prod.
SESSION_REPLAY_RETENTION_DAYS=30
CONSOLIDATION_INTERVAL_MS=                    # consolidation runner cadence
CONSOLIDATION_PERIOD_KIND=                    # hour|day|week
CONSOLIDATION_WINDOW_DAYS=14
CONSOLIDATION_CYCLE_WINDOW_DAYS=
