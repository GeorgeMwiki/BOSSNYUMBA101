# =============================================================================
# BOSSNYUMBA Environment Configuration — Complete Template
# =============================================================================
# RECOMMENDED — one-command bootstrap (creates Supabase project, generates
# secrets, applies migrations, seeds the dev tenant):
#
#   export SUPABASE_ACCESS_TOKEN=sbp_xxx     # from supabase.com/dashboard/account/tokens
#   pnpm setup-env
#
# Manual setup (if `pnpm setup-env` is not an option):
#   cp .env.example .env.local
#   pnpm gen-secrets --write                  # populate the TODO_BOSSNYUMBA_* secrets
#   # then hand-fill the TODO_BOSSNYUMBA_SUPABASE_* values from your project
#
# Markers used in this template:
#   TODO_BOSSNYUMBA_*  — project-specific value; `pnpm setup-env` replaces these
#   (empty value)      — optional; left blank for explicit opt-in
#   (default value)    — sensible default; safe to leave as-is in dev
#
# Runbook for the bootstrap script: Docs/RUNBOOKS/supabase-bootstrap.md
# First-time production live test:  Docs/SUPABASE_LIVE_TEST.md
# Master docs index:                Docs/INDEX.md
#
# Sections (top → bottom):
#   [REQUIRED]    — App will not start without these in production
#   [RECOMMENDED] — Core features degrade or run in stub-mode without these
#   [OPTIONAL]    — Feature-flagged; explicit opt-in
#   [LEGACY]      — Documented but slated for removal — do NOT add to new envs
# =============================================================================


# =============================================================================
# === REQUIRED for production live-test ======================================
# =============================================================================

# --- Supabase + Postgres ----------------------------------------------------
# BOSSNYUMBA needs ITS OWN Supabase project (NOT LITFIN's) for tenant isolation.
# `pnpm setup-env` creates one and fills these in automatically. Manual recipe:
#   1. https://supabase.com/dashboard/new → name "bossnyumba-dev"
#   2. Settings → API → copy URL, anon key, service_role key
#   3. Settings → API → JWT Settings → copy JWT Secret
# RLS ENFORCEMENT (defence-in-depth): in PRODUCTION, DATABASE_URL MUST point at a
# NON-BYPASS Postgres role (e.g. a dedicated `app_authenticated`). Supabase's
# `postgres` / `service_role` roles carry BYPASSRLS, which makes every Row-Level
# Security policy INERT — the gateway still binds app.current_tenant_id per request
# (SET LOCAL, inside a tx), but RLS only *enforces* under a non-BYPASS role. The
# gateway logs the connecting role's BYPASSRLS posture once at boot. Local dev may
# use the superuser below (RLS off) — never do so in production.
DATABASE_URL=postgresql://bossnyumba:bossnyumba_dev@localhost:5432/bossnyumba
DATABASE_URL_READONLY=                        # optional read-replica DSN for read-heavy queries
NEXT_PUBLIC_SUPABASE_URL=https://TODO_BOSSNYUMBA_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TODO_BOSSNYUMBA_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TODO_BOSSNYUMBA_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=TODO_BOSSNYUMBA_SUPABASE_JWT_SECRET
SUPABASE_ACCESS_TOKEN_KEY=TODO_BOSSNYUMBA_SUPABASE_ACCESS_TOKEN
# Server-side fallback for NEXT_PUBLIC_SUPABASE_URL (auth middleware, truth-engine
# admin client). Set to the same project URL when running services without the
# NEXT_PUBLIC_ prefix in scope.
SUPABASE_URL=
# OTP login (SMS / phone) is handled by Supabase Auth itself — the gateway only
# proxies /auth/v1/otp. [DEPLOY] Configure the SMS provider (Twilio / Africa's
# Talking / MessageBird) in Supabase Dashboard → Auth → Providers → Phone.
# No app env var; enable "Phone" sign-in and add provider creds in the dashboard.
# Physical-bucket env prefix used by `@bossnyumba/storage-adapter`.
# When unset, the wiring falls back to NODE_ENV, then 'development'.
SUPABASE_ENVIRONMENT=development

# --- JWT signing (auto-generated by `pnpm setup-env` / `pnpm gen-secrets`) ---
JWT_SECRET=TODO_BOSSNYUMBA_GENERATE_openssl_rand_base64_48     # HS256 access-token secret
JWT_ACCESS_SECRET=                            # service-to-service RS256 (manual)
JWT_REFRESH_SECRET=TODO_BOSSNYUMBA_GENERATE_openssl_rand_base64_48
JWT_AUDIENCE=bossnyumba
JWT_ISSUER=bossnyumba-api
JWT_EXPIRES_IN=15m

# --- Audit hash-chain (REQUIRED in production) ------------------------------
# Powers packages/ai-copilot/src/security/audit-hash-chain.ts.
# Auto-generated by `pnpm setup-env`. _PREV is the rotation overlap slot
# (see Docs/RUNBOOKS/encryption-at-rest-key-rotation.md).
SESSION_HASH_SECRET=TODO_BOSSNYUMBA_GENERATE_openssl_rand_base64_48
SESSION_HASH_SECRET_PREV=

# --- Field-level encryption (REQUIRED for PII at rest) ----------------------
# Auto-generated by `pnpm setup-env`. See Docs/RUNBOOKS/encryption-at-rest-key-rotation.md.
ENCRYPTION_MASTER_KEY=TODO_BOSSNYUMBA_GENERATE_openssl_rand_base64_32
ENCRYPTION_MASTER_KEY_PREVIOUS=               # set during rotation overlap window only
ENCRYPTION_KEY_VERSION=1                      # bump on every rotation
# [REQUIRED in prod] Salt for hashing user emails before they tag OTel spans.
# packages/observability throws at boot in production if OTel is on and this is
# unset (would leak raw emails into traces). openssl rand -base64 32.
USER_HASH_SALT=
BOSSNYUMBA_PII_EXTENDED=                       # '1' enables extended PII-redaction ruleset
# [REQUIRED in prod] HMAC root for the append-only audit-trail sink signatures
# (services/api-gateway audit-sink-drizzle adapter). openssl rand -base64 48.
AUDIT_TRAIL_SIGNING_SECRET=

# --- CORS + internal API key ------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
INTERNAL_API_KEY=TODO_BOSSNYUMBA_GENERATE_openssl_rand_hex_32

# --- API URLs (REQUIRED in production) --------------------------------------
API_URL=
API_BASE_URL=
API_GATEWAY_URL=
PUBLIC_API_BASE_URL=                          # base URL inside signed certs (RSP /verify)
PUBLIC_BASE_URL=                              # served in A2A agent-card manifest
FRONTEND_URL=
NEXT_PUBLIC_APP_URL=
# [DEPLOY] Next apps + owner-portal widget proxy /api/v1 to this gateway base.
# REQUIRED for every Next.js app (customer-app, tenant-portal, admin portals,
# marketing) and the embeddable chat widget in production.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_GATEWAY_URL=
NEXT_PUBLIC_API_BASE=                         # tenant-portal ask/marketplace client base

# --- Inter-service URLs (REQUIRED when the standalone service is deployed) ---
# [DEPLOY] Gateway → payments-ledger over HTTP for STK push + double-entry
# ledger posting (forwards the caller's Supabase JWT). REQUIRED for live
# M-Pesa money flow; without it the rent-payment path logs an error and
# refuses to initiate STK. Optional in dev (in-process stub).
PAYMENTS_LEDGER_URL=
TENANT_SERVICE_URL=                           # gateway → tenant-resolution service
IDENTITY_URL=                                 # admin-platform-portal → identity service proxy
MCP_PROCESS_INTEL_URL=                        # process-intelligence MCP sidecar
FORECASTING_REPO_URL=                         # forecasting-engine sidecar endpoint
TGN_INFERENCE_URL=                            # temporal-graph inference endpoint
APOLLO_AGENT_URL=                             # apollo-gauntlet-runner target agent
BOSSNYUMBA_OWNER_WEB_URL=                     # OAuth device-flow owner web redirect
BOSSNYUMBA_API_GATEWAY_URL=                   # marketing pilot-apply → gateway
BOSSNYUMBA_API_BASE_URL=                      # internal cross-service gateway base

# --- Node runtime -----------------------------------------------------------
NODE_ENV=development                          # development|test|production
LOG_LEVEL=info                                # trace|debug|info|warn|error|fatal
PORT=                                          # HTTP bind port (per service; gateway defaults 4000)
HOST=                                          # HTTP bind host (services default 0.0.0.0)


# =============================================================================
# === RECOMMENDED for production =============================================
# =============================================================================

# --- AI providers (cascade: Claude → OpenAI → DeepSeek) ---------------------
# Note: these provider keys (Anthropic, OpenAI, DeepSeek, ElevenLabs, Resend,
# Stripe sandbox, Twilio sandbox, Hume, Azure speech) are typically SHARED with
# LITFIN in dev because they're product-agnostic sandbox keys. Production gets
# its own — see Docs/RUNBOOKS/supabase-bootstrap.md § Production.
# [RECOMMENDED] ANTHROPIC_API_KEY powers the brain, copilots, doc-chat and
# narratives. Without it those features degrade gracefully to rule-based /
# stub output (no crash) — set it to enable real LLM reasoning in production.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_KEY=                                # fallback alias for ANTHROPIC_API_KEY
CLAUDE_API_KEY=                              # fallback alias for ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=                           # optional endpoint override
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6-20260217
ANTHROPIC_MODEL_DEFAULT=                      # alias override for CLAUDE_MODEL_DEFAULT
CLAUDE_MODEL_PREMIUM=claude-opus-4-6-20260210
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=
OPENAI_MODEL_DEFAULT=gpt-5.2
OPENAI_VOICE_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_REALTIME_URL=
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_DEFAULT=deepseek-chat
# Secondary providers (brain-llm-router / rerank / translation fallbacks)
GEMINI_API_KEY=                               # Google Gemini (brain-voice upstream)
GOOGLE_AI_API_KEY=                            # Google AI model-registry fetcher
GEMINI_VOICE_MODEL=                           # Gemini voice model id
COHERE_API_KEY=                               # ai-copilot retrieval rerank
HUGGINGFACE_API_KEY=                          # NLLB translation fallback
# Brain kill-switch + per-tenant/global LLM capacity governance
BOSSNYUMBA_AI_KILL_SWITCH=                    # 'true' fail-closes all LLM calls
BOSSNYUMBA_GLOBAL_LLM_CAPACITY=               # global concurrent LLM-call ceiling
BOSSNYUMBA_TENANT_LLM_CAPACITY=               # per-tenant concurrent LLM-call ceiling
KERNEL_USE_ORCHESTRATOR=                      # 'true' routes kernel via orchestrator
TRUTH_ENGINE_INJECTION_LLM=                   # 'true' enables LLM injection check
TRUTH_ENGINE_LLM_CONSENSUS=                   # 'true' enables LLM consensus check
TRUTH_ENGINE_SEMANTIC_LLM=                    # 'true' enables LLM semantic check
PROMPT_SHIELD_CONTEXT_STUFFING_THRESHOLD=     # token threshold for prompt-shield

# --- Redis (caching, rate limiting, BullMQ queues) --------------------------
