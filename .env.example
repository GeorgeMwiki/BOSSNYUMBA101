# widgets may render from, ON TOP of the package defaults + the live Supabase
# storage host (added automatically). Leave blank for the safe default
# allowlist. Example: cdn.example.com,assets.partner.io
BOSSNYUMBA_GENUI_MEDIA_ALLOWLIST=

