# =============================================================================
# === OPTIONAL / feature-flagged =============================================
# =============================================================================

# --- Connector fabric / OAuth (#12) -----------------------------------------
# The universal integration fabric (/api/v1/integrations/connectors) and its
# OAuth connect/callback/disconnect flow honest-degrade to a typed
# `not_provisioned` envelope until these are set — leaving them blank is safe.
# CONNECTOR_TOKEN_KEY seals access/refresh tokens at rest (AES-GCM DEK); the DB
# never sees plaintext. Generate a 32-byte key: `openssl rand -hex 32`.
CONNECTOR_TOKEN_KEY=
# HMAC secret signing the single-use OAuth `state` nonce. Falls back to
# CONNECTOR_TOKEN_KEY (or ENCRYPTION_MASTER_KEY) when unset; set explicitly to
# rotate it independently. `openssl rand -hex 32`.
CONNECTOR_OAUTH_STATE_SECRET=
# Public base URL the provider redirects back to. The callback path
# (/api/v1/integrations/connectors/connect/callback) is appended. Must be the
# externally-reachable gateway origin, e.g. https://api.bossnyumba.app
CONNECTOR_OAUTH_REDIRECT_BASE=
# Single-use OAuth state nonce TTL in ms (default 600000 = 10 min).
CONNECTOR_OAUTH_STATE_TTL_MS=
# Per-provider OAuth app credentials. One pair per connectorId (envPrefix is the
# uppercased provider): Slack today. Register the OAuth app with the redirect
# URI above and paste the values. Unset ⇒ that connector's connect flow returns
# a structured "provider OAuth app not configured" — never a crash.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Portal-GenUI render egress (BLOCKERS #10/#11) --------------------------
