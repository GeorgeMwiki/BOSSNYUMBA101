EXECUTIVE_BRIEF_CRON_INTERVAL_MS=             # executive-brief cron cadence
EXECUTIVE_BRIEF_CRON_DISABLED=                # 'true' disables executive-brief cron
HEARTBEAT_INTERVAL_MS=                        # sleep-pass-orchestrator heartbeat
SLEEP_PASS_PROD_ADAPTERS=                     # 'true' uses prod adapters in sleep-pass
NOTIFICATION_DISPATCH_DRAINER_DISABLED=       # 'true' disables notification drainer
NOTIFICATION_DLQ_DRAINER_DISABLED=            # 'true' disables dispatcher DLQ drainer (cross-channel-fallback redelivery)
NOTIFICATION_DLQ_DRAIN_INTERVAL_MS=           # dispatcher DLQ drainer cadence (default 30000)
SAVED_SEARCH_WORKER_DISABLED=                 # 'true' disables saved-search worker
