{
  "name": "@bossnyumba/swahili-intelligence",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Swahili morphology: tokenizer, analyzer, OOV detector, vocabulary service, response validator. Ported verbatim from LitFin src/core/swahili-intelligence.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^26.1.1"
  }
}
