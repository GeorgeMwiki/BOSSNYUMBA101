{
  "name": "@bossnyumba/fx-treasury-advisor",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "FX-treasury advisor — cash runway, FX exposure decomposition, sell-vs-stockpile decision, and the 27-Mar USD cliff remediation playbook for mining clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "@types/node": "^25.8.0"
  },
  "peerDependencies": {
    "@bossnyumba/database": "workspace:*",
    "@bossnyumba/ai-copilot": "workspace:*",
    "@bossnyumba/observability": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bossnyumba/database": { "optional": true },
    "@bossnyumba/ai-copilot": { "optional": true },
    "@bossnyumba/observability": { "optional": true }
  }
}
