{
  "name": "@bossnyumba/verification-stack",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Phase M-B Pre-Action Verification Stack: CoVe + Self-Refine + Constitutional gate + Self-Consistency + Multi-Agent Debate + pipeline composer. Mandatory verification before destructive MD actions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "verification",
    "cove",
    "chain-of-verification",
    "self-refine",
    "constitutional-ai",
    "self-consistency",
    "multi-agent-debate",
    "hallucination-reduction",
    "k-e-hardening"
  ],
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
