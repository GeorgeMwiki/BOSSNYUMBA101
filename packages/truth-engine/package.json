{
  "name": "@bossnyumba/truth-engine",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Truth engine: evidence collection, scoring, cross-source synthesis, claim store, answer grading, source authority + TTL. Ported verbatim from LitFin src/core/truth-engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bossnyumba/ai-copilot": "workspace:*",
    "@bossnyumba/enterprise-hardening": "workspace:*",
    "@bossnyumba/observability": "workspace:*",
    "@bossnyumba/supabase-client": "workspace:*",
    "@supabase/supabase-js": "^2.106.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^26.1.1"
  }
}
