{
  "name": "@bossnyumba/streaming-client",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Mobile-first streaming client: SSE transport, optimistic state reducer, IndexedDB offline cache (idb-keyval), Network Information API policy. Phase J8 client-side deliverable.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
