# =============================================================================
# BOSSNYUMBA API Gateway — Multi-stage Dockerfile
# =============================================================================
# Build: docker build -f docker/Dockerfile.api -t bossnyumba/api-gateway:dev .
# Listens on :4000, serves /health and /healthz.
#
# Because services/api-gateway/tsup.config.ts bundles every `@bossnyumba/*`
# workspace dep (`noExternal: [/^@bossnyumba\//]`), the runner stage only
# needs the api-gateway dist + external node_modules. No symlink farm.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder (single combined stage — install + build)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder
# libc6-compat: glibc-shim for prebuilt binaries (e.g. @swc/core).
# python3 + build-base: needed by node-gyp when an OPTIONAL native
# dependency (canvas via pdfkit, etc.) tries to compile from source on
# musl. They live only in the builder stage and never reach the runner.
RUN apk add --no-cache libc6-compat python3 make g++
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json tsconfig.json ./
COPY .npmrc ./
COPY packages ./packages
COPY services ./services

RUN pnpm install --frozen-lockfile

# Build api-gateway and every workspace dep it pulls in. tsup's
# noExternal regex bakes the workspace `@bossnyumba/*` modules into the
# api-gateway artifact so the runner stage is fully self-contained.
RUN pnpm --filter=@bossnyumba/api-gateway... --workspace-concurrency=1 build

# -----------------------------------------------------------------------------
# Stage 2: Runner (minimal — bundled dist + the api-gateway's own deps)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner
RUN apk add --no-cache dumb-init wget

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 apigateway

WORKDIR /app

# Bundle ships @bossnyumba/* baked in; we only need:
#   1. The built dist/.
#   2. The api-gateway's own node_modules (pg, ioredis, etc.).
#   3. The api-gateway package.json (so node finds the entrypoint).
COPY --from=builder --chown=apigateway:nodejs /app/services/api-gateway/dist ./dist
COPY --from=builder --chown=apigateway:nodejs /app/services/api-gateway/package.json ./package.json
COPY --from=builder --chown=apigateway:nodejs /app/services/api-gateway/node_modules ./node_modules

USER apigateway

ENV NODE_ENV=production \
    PORT=4000

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/healthz || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
