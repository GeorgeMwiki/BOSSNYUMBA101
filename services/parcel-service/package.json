{
  "name": "@bossnyumba/parcel-service",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Muzima parcel-service — REST + MCP wrapper over PostGIS parcels, with geocoder chain (Google → Plus Codes → what3words → Nominatim) and snap-to-nearest-building helper. Spec: .audit/litfin-sota-2026-05-23/17-spatial-parcel-engine.md (Part E §3 + §H).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@bossnyumba/observability": "workspace:^",
    "@bossnyumba/spatial-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^5.8.3",
    "pino": "^8.21.0",
    "uuid": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
